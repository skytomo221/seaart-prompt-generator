{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "seaart-prompt-generator",
  "version": "3.0.0",
  "identifier": "com.skytomo221.seaart-prompt-generator",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "seaart-prompt-generator",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/skytomo221/seaart-prompt-generator/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJGQTI1RDQ2OUNDMjFGMEEKUldRS0g4S2NSbDJpdi9aVjhocUIxandRTDQ1K21iaDdmb1BvT1VJK0hXd1grODFKeFd6UWhtSDgK"
    }
  }
}
